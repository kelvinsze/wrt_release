# ZN-M2-specific overrides. Applied AFTER compile_base.config and nss.config.
# Keep package manager consistent with the installed LibWrt 25.12 APK system.
CONFIG_USE_APK=y
# Do not force legacy OPKG LuCI library on an APK build.
# CONFIG_PACKAGE_luci-lib-ipkg is not set

# Required applications. Mihomo core may be downloaded separately by OpenClash.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y

# Drop base profile extras.
# CONFIG_PACKAGE_easytier is not set
# CONFIG_PACKAGE_luci-app-easytier is not set
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_luci-app-pbr is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_proto-bonding is not set
# CONFIG_PACKAGE_luci-proto-relay is not set
# CONFIG_PACKAGE_libopenssl-legacy is not set
# CONFIG_BUSYBOX_CONFIG_TELNET is not set

# No NSS SQM scripts unless traffic shaping is explicitly required.
# CONFIG_PACKAGE_sqm-scripts-nss is not set
